model Client {
    id          Int       @id @default(autoincrement())
    clientOldId String    @unique
    clientType  String?
    clientFName String
    clientLName String
    companyName String
    email       String    @unique
    phone       String    @unique
    division    String
    district    String
    thana       String
    locationId  Int?
    location    Location? @relation(fields: [locationId], references: [id])
    fullAddress String
    status      String    @default("active")
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@map("clients")
}
